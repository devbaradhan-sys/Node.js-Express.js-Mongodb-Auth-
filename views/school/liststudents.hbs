<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th>Name</th>
      <th>Maths</th>
      <th>Science</th>
      <th>Social</th>
      <th>Total</th>
      <th style="width: 250px;">Actions</th>
    </tr>
  </thead>
  <tbody>
    {{#if students.length}}
      {{#each students}}
      <tr>
        <td>{{this.name}}</td>
        <td>{{this.subjects.maths}}</td>
        <td>{{this.subjects.science}}</td>
        <td>{{this.subjects.social}}</td>
        <td>{{this.subjects.total}}</td>
        <td>

          <a href="/school/editstudent/{{this._id}}" class="btn btn-warning btn-sm">Edit</a>

          {{#ifEquals ../user.role "ADMIN"}}
            <a href="/school/deletestudent/{{this._id}}" class="btn btn-danger btn-sm">Delete</a>
          {{/ifEquals}}
        </td>
      </tr>
      {{/each}}
    {{else}}
      <tr>
        <td colspan="6" class="text-center">No students found.</td>
      </tr>
    {{/if}}
  </tbody>
</table>
